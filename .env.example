# Copy to .env and adjust. Never commit .env or real secrets.

# --- PostgreSQL ---
POSTGRES_USER=chatterbox
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=chatterbox

# --- API ---
NODE_ENV=development
API_PORT=4000
# Address the API listens on. 127.0.0.1 keeps local development on this machine only.
# Docker sets 0.0.0.0 so that other containers can reach it.
API_HOST=127.0.0.1
DATABASE_URL=postgresql://chatterbox:change-me-local-only@localhost:5432/chatterbox
# Generate a real value with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
# Origin allowed to call the API (the web app). This is the Vite dev server address.
# Docker Compose sets its own value from WEB_PORT below.
WEB_ORIGIN=http://localhost:5173

# --- Web ---
# The browser calls this path on its own address; the Vite dev server forwards it to the API.
VITE_API_URL=/api

# --- Docker Compose ---
# Port on this machine where the web app is published (http://localhost:8080).
WEB_PORT=8080