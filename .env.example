# Copy to .env and adjust. Never commit .env or real secrets.

# --- PostgreSQL ---
POSTGRES_USER=chatterbox
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=chatterbox
# Port on this machine where the database is published, only when you opt in with
# docker-compose.debug.yml (see the README). It is not published by default.
DB_PORT=5432

# --- API ---
NODE_ENV=development
API_PORT=4000
# Address the API listens on. 127.0.0.1 keeps local development on this machine only.
# Docker sets 0.0.0.0 so that other containers can reach it.
API_HOST=127.0.0.1
DATABASE_URL=postgresql://chatterbox:change-me-local-only@localhost:5432/chatterbox
# Used by the tests only. The name must end in _test, because the tests empty its tables.
TEST_DATABASE_URL=postgresql://chatterbox:change-me-local-only@localhost:5432/chatterbox_test
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The API refuses to start in production while this is still a placeholder.
SESSION_SECRET=replace-with-a-long-random-string
# Origin allowed to call the API (the web app). This is the Vite dev server address.
# Docker Compose sets its own value from WEB_PORT below.
WEB_ORIGIN=http://localhost:5173
# Secure cookies need HTTPS. The default is on in production and off otherwise. The Docker demo
# runs over HTTP, so Compose turns it off unless you set COOKIE_SECURE=true here.
# COOKIE_SECURE=false

# --- Web ---
# The browser calls this path on its own address; the Vite dev server forwards it to the API.
VITE_API_URL=/api

# --- Docker Compose ---
# Port on this machine where the web app is published (http://localhost:8080).
WEB_PORT=8080
